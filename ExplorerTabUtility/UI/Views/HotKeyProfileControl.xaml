<UserControl x:Class="ExplorerTabUtility.UI.Views.HotKeyProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ExplorerTabUtility.UI.Views.Controls"
             mc:Ignorable="d"
             TextBlock.Foreground="{StaticResource TextPrimaryBrush}"
             TextElement.Foreground="{StaticResource TextPrimaryBrush}"
             d:DesignHeight="125" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource ProfileCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Enabled Toggle -->
                <ToggleButton x:Name="CbEnabled" Grid.Column="0" Style="{StaticResource ToggleButtonStyle}"
                              VerticalAlignment="Stretch" ToolTip="启用或停用此配置" />

                <!-- Name -->
                <TextBox x:Name="TxtName" Grid.Column="1" Tag="名称" Style="{StaticResource CustomTextBoxStyle}"
                         ToolTip="配置名称" />

                <!-- Hotkeys -->
                <TextBox x:Name="TxtHotKeys" Grid.Column="3" Tag="快捷键" Style="{StaticResource CustomTextBoxStyle}"
                         ToolTip="要监听的键盘或鼠标按键，点击可录入新的组合键" />

                <!-- Scope -->
                <ComboBox x:Name="CbScope" Grid.Column="5" Style="{StaticResource CustomComboBoxStyle}"
                          ToolTip="生效范围：全局（任意位置）或仅资源管理器获得焦点时" />

                <!-- Action -->
                <ComboBox x:Name="CbAction" Grid.Column="6" Style="{StaticResource CustomComboBoxStyle}" Width="210"
                          ToolTip="按下快捷键时执行的动作" />

                <!-- Expander button -->
                <ToggleButton x:Name="ExpanderToggle" Grid.Column="7" Margin="4, 0" Style="{StaticResource ToggleButtonArrowStyle}"
                              ToolTip="显示更多选项" />

                <!-- Delete Button -->
                <Button x:Name="BtnDelete" Grid.Column="8" ToolTip="删除此配置">
                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16"
                          Height="16" />
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Expanded Details -->
            <Grid x:Name="ExpandedPanel" Grid.Row="1" Margin="0, 6, 0, 0"
                  Visibility="{Binding ElementName=ExpanderToggle, Path=IsChecked, Mode=TwoWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Path -->
                <TextBox Grid.Column="0" x:Name="TxtPath" Tag="位置" Style="{StaticResource CustomTextBoxStyle}"
                         ContextMenu="{StaticResource TextBoxCustomContextMenu}"
                         ToolTip="按下快捷键时打开的路径（文件夹、文件、网址或 CLSID）" />

                <!-- Delay -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6"
                            ToolTip="执行动作前的延迟（毫秒）">
                    <TextBlock Text="延迟" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <controls:NumericInputControl x:Name="NDelay"
                                                  Margin="0"
                                                  MinWidth="100"
                                                  Minimum="0"
                                                  Maximum="10000"
                                                  Step="100"
                                                  Suffix="ms"
                                                  StringFormat="{}{0:N0}" />
                </StackPanel>

                <!-- Handled -->
                <ToggleButton Grid.Column="2" x:Name="CbHandled" Content="拦截" Style="{StaticResource ToggleButtonStyle}" Margin="5,0"
                              ToolTip="阻止其他程序继续接收该快捷键" />

                <!-- Open as Tab -->
                <ToggleButton Grid.Column="3" x:Name="CbOpenAsTab" Content="标签页" Style="{StaticResource ToggleButtonStyle}" Margin="5,0"
                              ToolTip="以标签页打开，而不是新窗口" />
            </Grid>
        </Grid>
    </Border>
</UserControl>